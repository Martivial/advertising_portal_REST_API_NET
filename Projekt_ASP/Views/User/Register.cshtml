
@model Projekt_ASP.Shared.DTOs.RegisterRequest

@{
    ViewData["Title"] = "Rejestracja";
    ViewData["PageCss"] = "auth.css";
}

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-icon">
            <i class="bi bi-person-plus"></i>
        </div>

        <h1>Utwórz konto</h1>

        <p class="auth-subtitle">
            Dołącz do nas i publikuj własne ogłoszenia.
        </p>

        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="alert alert-success" role="alert">
                @success
            </div>
        }

        <form asp-controller="User"
              asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger validation-summary"
                 role="alert"></div>

            <div class="auth-field">
                <label asp-for="UserName">Nazwa użytkownika</label>
                <div class="auth-input-wrapper">
                    <i class="bi bi-person"></i>
                    <input asp-for="UserName"
                           class="form-control"
                           autocomplete="username"
                           placeholder="Np. jan123" />
                </div>
                <span asp-validation-for="UserName"
                      class="field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Email">Adres e-mail</label>
                <div class="auth-input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email"
                           class="form-control"
                           type="email"
                           autocomplete="email"
                           placeholder="jan@example.com" />
                </div>
                <span asp-validation-for="Email"
                      class="field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password">Hasło</label>
                <div class="auth-input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password"
                           class="form-control"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Utwórz hasło" />
                </div>
                <span asp-validation-for="Password"
                      class="field-error"></span>
                <small class="auth-hint">
                    Wymagana jest duża litera, cyfra i znak specjalny.
                </small>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword">
                    Potwierdź hasło
                </label>
                <div class="auth-input-wrapper">
                    <i class="bi bi-shield-lock"></i>
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Powtórz hasło" />
                </div>
                <span asp-validation-for="ConfirmPassword"
                      class="field-error"></span>
            </div>

            <button type="submit" class="auth-submit">
                Utwórz konto
                <i class="bi bi-arrow-right"></i>
            </button>
        </form>

        <div class="auth-footer">
            Masz już konto?
            <a asp-controller="User" asp-action="Login">
                Zaloguj się
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
