
@model Projekt_ASP.Shared.DTOs.LoginRequest

@{
    ViewData["Title"] = "Logowanie";
    ViewData["PageCss"] = "auth.css";
}

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-icon">
            <i class="bi bi-person-check"></i>
        </div>

        <h1>Witaj ponownie!</h1>

        <p class="auth-subtitle">
            Zaloguj się, aby zarządzać swoimi ogłoszeniami.
        </p>

        <form asp-controller="User"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger validation-summary"
                 role="alert"></div>

            <div class="auth-field">
                <label asp-for="Email">Adres e-mail</label>
                <div class="auth-input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email"
                           class="form-control"
                           type="email"
                           autocomplete="email"
                           placeholder="jan@example.com" />
                </div>
                <span asp-validation-for="Email"
                      class="field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password">Hasło</label>
                <div class="auth-input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password"
                           class="form-control"
                           type="password"
                           autocomplete="current-password"
                           placeholder="Wpisz hasło" />
                </div>
                <span asp-validation-for="Password"
                      class="field-error"></span>
            </div>

            <button type="submit" class="auth-submit">
                Zaloguj się
                <i class="bi bi-arrow-right"></i>
            </button>
        </form>

        <div class="auth-footer">
            Nie masz jeszcze konta?
            <a asp-controller="User" asp-action="Register">
                Zarejestruj się
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
