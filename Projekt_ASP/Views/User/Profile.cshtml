
@model List<Projekt_ASP.Shared.Models.Ads.Ad>

@{
    ViewData["Title"] = "Moje konto";
    ViewData["PageCss"] = "profile.css";
}

<div class="container profile-page">

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">
            @success
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }

    <div class="profile-header">
        <div class="profile-avatar">
            <i class="bi bi-person-fill"></i>
        </div>

        <div>
            <h1>Moje konto</h1>
            <p>Witaj, @ViewBag.UserName!</p>
        </div>
    </div>

    <section class="profile-section">

        <div class="section-heading">
            <div>
                <h2>Moje ogłoszenia</h2>
                <p>Ogłoszenia opublikowane przez Ciebie</p>
            </div>

            <a asp-controller="Ads"
               asp-action="Create"
               class="btn-teal-custom">
                <i class="bi bi-plus-lg"></i>
                Dodaj ogłoszenie
            </a>
        </div>

        <div class="ads-count">
            Liczba ogłoszeń: <strong>@Model.Count</strong>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-profile">
                <i class="bi bi-inbox"></i>

                <h3>Nie masz jeszcze ogłoszeń</h3>

                <p>Dodaj pierwsze ogłoszenie, a pojawi się ono tutaj.</p>

                <a asp-controller="Ads"
                   asp-action="Create"
                   class="btn-primary-custom">
                    Dodaj ogłoszenie
                </a>
            </div>
        }
        else
        {
            <div class="my-ads-list">

                @foreach (var ad in Model)
                {
                    <article class="my-ad-card">

                        <div class="my-ad-info">
                            <h3>@ad.Title</h3>

                            <p class="my-ad-description">
                                @ad.Description
                            </p>

                            <div class="my-ad-meta">
                                <span>
                                    <i class="bi bi-tag"></i>
                                    @ad.Category
                                </span>

                                <span>
                                    <i class="bi bi-geo-alt"></i>
                                    @ad.Location
                                </span>

                                <span>
                                    <i class="bi bi-calendar3"></i>
                                    @ad.PostedDate.ToLocalTime().ToString("dd.MM.yyyy")
                                </span>
                            </div>
                        </div>

                        <div class="my-ad-actions">

                            <strong class="my-ad-price">
                                @ad.Price.ToString("N2") zł
                            </strong>

                            <a asp-controller="Ads"
                               asp-action="Details"
                               asp-route-id="@ad.Id"
                               class="btn-outline-custom">
                                <i class="bi bi-eye"></i>
                                Zobacz
                            </a>

                            <a asp-controller="Ads"
                               asp-action="Edit"
                               asp-route-id="@ad.Id"
                               class="btn-outline-custom">
                                <i class="bi bi-pencil"></i>
                                Edytuj
                            </a>

                            <form asp-controller="Ads"
                                  asp-action="Delete"
                                  asp-route-id="@ad.Id"
                                  method="post"
                                  onsubmit="return confirm('Czy na pewno chcesz usunąć to ogłoszenie?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn-delete-custom">
                                    <i class="bi bi-trash"></i>
                                    Usuń
                                </button>

                            </form>

                        </div>
                    </article>
                }

            </div>
        }

    </section>
</div>