
@model Projekt_ASP.Models.Ads.Ad

@{
    ViewData["Title"] = "Dodaj ogłoszenie";
}

<div class="container mt-5 mb-5" style="max-width: 750px;">
    <h1 class="text-center mb-4">Dodaj ogłoszenie</h1>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label">Kategoria</label>
            <select asp-for="Category" id="Category" class="form-select" required>
                <option value="">Wybierz kategorię</option>
                <option value="Motoryzacja">Motoryzacja</option>
                <option value="Nieruchomości">Nieruchomości</option>
                <option value="Praca">Praca</option>
                <option value="Elektronika">Elektronika</option>
                <option value="Usługi">Usługi</option>
                <option value="Dom i ogród">Dom i ogród</option>
                <option value="Moda">Moda</option>
                <option value="Dla dzieci">Dla dzieci</option>
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Tytuł</label>
            <input asp-for="Title" class="form-control" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Opis</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Cena (zł)</label>
            <input asp-for="Price" type="number" min="0" step="0.01" class="form-control" required />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label">Lokalizacja</label>
            <input asp-for="Location" class="form-control" required />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label">Telefon</label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <hr />
        <h4>Szczegóły kategorii</h4>
        <p class="text-muted">Wypełnij pola odpowiednie dla wybranej kategorii.</p>

        <div class="category-fields" data-category="Motoryzacja">
            <div class="mb-3">
                <label class="form-label">Marka pojazdu</label>
                <input name="VehicleDetails.VehicleBrand" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Model pojazdu</label>
                <input name="VehicleDetails.VehicleModel" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Rok produkcji</label>
                <input name="VehicleDetails.VehicleYear" type="number" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Przebieg (km)</label>
                <input name="VehicleDetails.VehicleMileage" type="number" class="form-control" />
            </div>
        </div>

        <div class="category-fields" data-category="Nieruchomości">
            <div class="mb-3">
                <label class="form-label">Typ nieruchomości</label>
                <input name="PropertyDetails.PropertyType" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Powierzchnia (m²)</label>
                <input name="PropertyDetails.PropertyArea" type="number" step="0.01" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Liczba pokoi</label>
                <input name="PropertyDetails.PropertyRooms" type="number" class="form-control" />
            </div>
        </div>

        <div class="category-fields" data-category="Praca">
            <div class="mb-3">
                <label class="form-label">Stanowisko</label>
                <input name="JobDetails.JobTitle" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Firma</label>
                <input name="JobDetails.JobCompany" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Typ zatrudnienia</label>
                <input name="JobDetails.JobEmploymentType" class="form-control" />
            </div>
        </div>

        <div class="category-fields" data-category="Elektronika">
            <div class="mb-3">
                <label class="form-label">Typ elektroniki</label>
                <input name="ElectronicsDetails.ElectronicsType" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Marka</label>
                <input name="ElectronicsDetails.ElectronicsBrand" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Model</label>
                <input name="ElectronicsDetails.ElectronicsModel" class="form-control" />
            </div>
        </div>

        <div class="category-fields" data-category="Usługi">
            <div class="mb-3">
                <label class="form-label">Typ usługi</label>
                <input name="ServiceDetails.ServiceType" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Opis usługi</label>
                <textarea name="ServiceDetails.ServiceDescription" class="form-control"></textarea>
            </div>
        </div>

        <div class="category-fields" data-category="Dom i ogród">
            <div class="mb-3">
                <label class="form-label">Typ artykułu</label>
                <input name="HomeAndGardenDetails.HomeAndGardenType" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Stan</label>
                <input name="HomeAndGardenDetails.HomeAndGardenCondition" class="form-control" />
            </div>
        </div>

        <div class="category-fields" data-category="Moda">
            <div class="mb-3">
                <label class="form-label">Typ odzieży</label>
                <input name="FashionDetails.FashionType" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Rozmiar</label>
                <input name="FashionDetails.FashionSize" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Kolor</label>
                <input name="FashionDetails.FashionColor" class="form-control" />
            </div>
        </div>

        <div class="category-fields" data-category="Dla dzieci">
            <div class="mb-3">
                <label class="form-label">Typ artykułu</label>
                <input name="KidsItemDetails.KidsItemType" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Przedział wiekowy</label>
                <input name="KidsItemDetails.KidsAgeRange" class="form-control" />
            </div>
        </div>

        <div class="mb-4">
            <label for="images" class="form-label">Zdjęcia</label>
            <input type="file" id="images" name="images" class="form-control" multiple accept="image/*" />
        </div>

        <button type="submit" class="btn text-white" style="background-color:#1d8968;">
            Dodaj ogłoszenie
        </button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Anuluj</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const categorySelect = document.getElementById("Category");
        const categoryFields = document.querySelectorAll(".category-fields");

        function updateCategoryFields() {
            categoryFields.forEach(section => {
                section.style.display =
                    section.dataset.category === categorySelect.value ? "block" : "none";
            });
        }

        categorySelect.addEventListener("change", updateCategoryFields);
        updateCategoryFields();
    </script>
}
