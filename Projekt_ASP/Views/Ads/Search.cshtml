
@model IEnumerable<Projekt_ASP.Models.Ads.Ad>

<div class="container mt-4">
    <h1 class="text-center mb-4">Wyniki wyszukiwania</h1>

    <form asp-controller="Ads" asp-action="Search" method="get" class="input-group mb-4">
        <input type="text" class="form-control" name="query"
               value="@ViewData["Query"]" placeholder="Wpisz, czego szukasz..." />
        <button type="submit" class="btn text-white" style="background-color:#1d8968;">Szukaj</button>
    </form>

    @if (Model == null || !Model.Any())
    {
        <p class="text-center">Nie znaleziono ogłoszeń.</p>
    }
    else
    {
        <div class="row">
            @foreach (var ad in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        @if (ad.Images != null && ad.Images.Any(i => i.ImageData != null && i.ImageData.Length > 0))
                        {
                            var image = ad.Images.First(i => i.ImageData != null && i.ImageData.Length > 0);
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(image.ImageData)"
                                 class="card-img-top" style="height:200px; object-fit:cover;"
                                 alt="Zdjęcie ogłoszenia" />
                        }

                        <div class="card-body">
                            <h5 class="card-title">@ad.Title</h5>
                            <p>@ad.Description</p>
                            <p><strong>Cena:</strong> @ad.Price.ToString("N2") zł</p>
                            <p><strong>Lokalizacja:</strong> @ad.Location</p>
                            <p><strong>Kategoria:</strong> @ad.Category</p>
                            <a asp-action="Details" asp-route-id="@ad.Id" class="btn text-white" style="background-color:#1d8968;">Szczegóły</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
