
@model IEnumerable<Projekt_ASP.Models.Ads.Ad>

<div class="container text-center mt-4">
    <h2 class="mb-4">Twoje ogłoszenia</h2>

    @if (Model == null || !Model.Any())
    {
        <p>Nie masz jeszcze żadnych ogłoszeń.</p>
    }
    else
    {
        <div class="row">
            @foreach (var ad in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        @if (ad.Images != null && ad.Images.Any(i => i.ImageData != null && i.ImageData.Length > 0))
                        {
                            var image = ad.Images.First(i => i.ImageData != null && i.ImageData.Length > 0);
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(image.ImageData)"
                                 class="card-img-top" style="height:200px; object-fit:cover;"
                                 alt="Zdjęcie ogłoszenia" />
                        }

                        <div class="card-body text-start">
                            <h5 class="card-title">@ad.Title</h5>
                            <p>@ad.Description</p>
                            <p><strong>Cena:</strong> @ad.Price.ToString("N2") zł</p>
                            <p><strong>Lokalizacja:</strong> @ad.Location</p>
                            <p><strong>Kategoria:</strong> @ad.Category</p>

                            <a asp-action="Details" asp-route-id="@ad.Id" class="btn btn-outline-success">Szczegóły</a>
                            <a asp-action="Edit" asp-route-id="@ad.Id" class="btn text-white" style="background-color:#1d8968;">Edytuj</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
