
@model Projekt_ASP.Models.Ads.Ad

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-6 mb-4">
            @if (Model.Images != null && Model.Images.Any())
            {
                <div id="adImages" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @{
                            var validImages = Model.Images
                                .Where(i => i.ImageData != null && i.ImageData.Length > 0)
                                .ToList();
                        }
                        @for (var i = 0; i < validImages.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(validImages[i].ImageData)"
                                     class="d-block w-100"
                                     style="max-height:500px; object-fit:contain;"
                                     alt="Zdjęcie ogłoszenia" />
                            </div>
                        }
                    </div>
                    @if (validImages.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#adImages" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                            <span class="visually-hidden">Poprzednie</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#adImages" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                            <span class="visually-hidden">Następne</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-light">Brak zdjęć tego ogłoszenia.</div>
            }
        </div>

        <div class="col-md-6">
            <h1>@Model.Title</h1>
            <p class="text-muted">Kategoria: @Model.Category</p>
            <p class="text-muted">Dodano: @Model.PostedDate.ToString("dd.MM.yyyy")</p>

            <h3 class="mt-3">@Model.Price.ToString("N2") zł</h3>
            <p><strong>Lokalizacja:</strong> @Model.Location</p>

            @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
            {
                <p><strong>Telefon:</strong> @Model.PhoneNumber</p>
            }

            <h4 class="mt-4">Opis</h4>
            <p style="white-space:pre-wrap;">@Model.Description</p>

            @if (Model.VehicleDetails != null)
            {
                <h4 class="mt-4">Dane pojazdu</h4>
                <p><strong>Marka:</strong> @Model.VehicleDetails.VehicleBrand</p>
                <p><strong>Model:</strong> @Model.VehicleDetails.VehicleModel</p>
                <p><strong>Rok:</strong> @Model.VehicleDetails.VehicleYear</p>
                <p><strong>Przebieg:</strong> @Model.VehicleDetails.VehicleMileage km</p>
            }

            @if (Model.PropertyDetails != null)
            {
                <h4 class="mt-4">Dane nieruchomości</h4>
                <p><strong>Typ:</strong> @Model.PropertyDetails.PropertyType</p>
                <p><strong>Powierzchnia:</strong> @Model.PropertyDetails.PropertyArea m²</p>
                <p><strong>Liczba pokoi:</strong> @Model.PropertyDetails.PropertyRooms</p>
            }

            @if (Model.JobDetails != null)
            {
                <h4 class="mt-4">Dane oferty pracy</h4>
                <p><strong>Stanowisko:</strong> @Model.JobDetails.JobTitle</p>
                <p><strong>Firma:</strong> @Model.JobDetails.JobCompany</p>
                <p><strong>Typ zatrudnienia:</strong> @Model.JobDetails.JobEmploymentType</p>
            }

            @if (Model.ElectronicsDetails != null)
            {
                <h4 class="mt-4">Dane elektroniki</h4>
                <p><strong>Typ:</strong> @Model.ElectronicsDetails.ElectronicsType</p>
                <p><strong>Marka:</strong> @Model.ElectronicsDetails.ElectronicsBrand</p>
                <p><strong>Model:</strong> @Model.ElectronicsDetails.ElectronicsModel</p>
            }

            @if (Model.ServiceDetails != null)
            {
                <h4 class="mt-4">Dane usługi</h4>
                <p><strong>Typ:</strong> @Model.ServiceDetails.ServiceType</p>
                <p><strong>Opis:</strong> @Model.ServiceDetails.ServiceDescription</p>
            }

            @if (Model.HomeAndGardenDetails != null)
            {
                <h4 class="mt-4">Dom i ogród</h4>
                <p><strong>Typ:</strong> @Model.HomeAndGardenDetails.HomeAndGardenType</p>
                <p><strong>Stan:</strong> @Model.HomeAndGardenDetails.HomeAndGardenCondition</p>
            }

            @if (Model.FashionDetails != null)
            {
                <h4 class="mt-4">Moda</h4>
                <p><strong>Typ:</strong> @Model.FashionDetails.FashionType</p>
                <p><strong>Rozmiar:</strong> @Model.FashionDetails.FashionSize</p>
                <p><strong>Kolor:</strong> @Model.FashionDetails.FashionColor</p>
            }

            @if (Model.KidsItemDetails != null)
            {
                <h4 class="mt-4">Dla dzieci</h4>
                <p><strong>Typ:</strong> @Model.KidsItemDetails.KidsItemType</p>
                <p><strong>Wiek:</strong> @Model.KidsItemDetails.KidsAgeRange</p>
            }

            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Strona główna</a>
                <a asp-action="CategoryAds" asp-route-category="@Model.Category"
                   class="btn text-white" style="background-color:#1d8968;">Wróć do kategorii</a>
            </div>
        </div>
    </div>
</div>
