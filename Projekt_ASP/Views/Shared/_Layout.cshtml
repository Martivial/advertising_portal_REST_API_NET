
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ogłoszenia</title>
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
          @if (ViewData["PageCss"] is string pageCss)
{
    <link rel="stylesheet"
          href="~/css/@pageCss"
          asp-append-version="true" />
}

   
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg main-navbar">
            <div class="container">
                <a class="brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon">O</span>
                    <span>Ogłoszenia</span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav"
                        aria-controls="mainNav"
                        aria-expanded="false"
                        aria-label="Pokaż nawigację">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Przeglądaj ogłoszenia
                            </a>
                        </li>

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <li class="nav-item">
                                <a class="btn-teal-custom"
                                   asp-controller="Ads"
                                   asp-action="Create">
                                    + Dodaj ogłoszenie
                                </a>
                            </li>

                            <li class="nav-item">
  
<li class="nav-item">
    <a class="user-label text-decoration-none"
       asp-controller="User"
       asp-action="Profile">
        <i class="bi bi-person-circle"></i>
        Moje konto
    </a>
</li>
</li>

                            <li class="nav-item">
                                <form asp-controller="User"
                                      asp-action="Logout"
                                      method="post"
                                      class="m-0">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn-primary-custom">
                                        Wyloguj
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="User"
                                   asp-action="Login">
                                    Logowanie
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn-primary-custom"
                                   asp-controller="User"
                                   asp-action="Register">
                                    Załóż konto
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex flex-column flex-sm-row
                    justify-content-between align-items-sm-center gap-2">
            <div>
                <span class="footer-brand">Ogłoszenia</span>
                <span class="ms-2">Znajdź. Dodaj. Sprzedaj.</span>
            </div>

            <div class="small">
                © @DateTime.Now.Year Portal ogłoszeniowy
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
